generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["codewix_ai", "public"]
}

model GeneratedApp {
  id        String   @id @default(nanoid(5))
  model     String
  prompt    String
  code      String
  createdAt DateTime @default(now())

  @@index([id])
  @@schema("codewix_ai")
}

model Chat {
  id                String    @id @default(nanoid(16))
  model             String
  quality           String
  prompt            String
  title             String
  braintrustParent  String?
  llamaCoderVersion String    @default("v2")
  shadcn            Boolean
  // userId is backfilled from Project.chatId -> Project.userId for existing
  // chats, and set directly on creation for new chats. Nullable for backward
  // compat with chats that have no associated Project.
  userId            String?
  messages          Message[]
  createdAt         DateTime  @default(now())

  @@index([createdAt])
  @@index([userId])
  @@schema("codewix_ai")
}

model Message {
  id        String   @id @default(nanoid(16))
  role      String
  content   String
  files     Json?
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([chatId, createdAt])
  @@schema("codewix_ai")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  email         String        @unique
  passwordHash  String        @map("password_hash")
  emailVerified Boolean       @default(false) @map("email_verified")
  githubId      String?       @map("github_id")
  image         String?
  // Monotonically increasing version embedded in the session JWT. Bumping this
  // (on password reset) invalidates all existing sessions for the user.
  tokenVersion  Int           @default(0) @map("token_version")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  projects      Project[]
  chatSessions  ChatSession[]

  @@map("users")
  @@schema("public")
}

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  code      String   @db.Char(6)
  purpose   String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@index([email, purpose])
  @@index([email, purpose, used])
  @@map("otp_codes")
  @@schema("public")
}

model Project {
  id            String            @id
  userId        String            @map("user_id") @db.Uuid
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String
  projectTypeId String            @map("project_type_id") @db.Uuid
  projectType   ProjectType       @relation(fields: [projectTypeId], references: [id], onDelete: Restrict)
  visibilityId  String            @map("visibility_id") @db.Uuid
  visibility    ProjectVisibility @relation(fields: [visibilityId], references: [id], onDelete: Restrict)
  chatId        String?           @map("chat_id")
  files         Json              @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([projectTypeId])
  @@index([visibilityId])
  @@map("projects")
  @@schema("public")
}

// Dropdown options for the project-creation dialog. Rows are seeded/managed
// in the database (see migration + admin tooling) - never hardcode these in
// application code.
model ProjectType {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  projects  Project[]

  @@map("project_types")
  @@schema("public")
}

model ProjectVisibility {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  projects  Project[]

  @@map("project_visibilities")
  @@schema("public")
}

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId     String   @map("run_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("chat_sessions")
  @@schema("public")
}
