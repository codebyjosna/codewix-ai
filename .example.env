# ─── AI Provider API Keys (server-side only) ─────────────────────────
#
# ── ACTIVE PROVIDER ────────────────────────────────────────────────
# Mistral AI is the ONLY active provider.  Get a key from:
#   https://console.mistral.ai/api-keys
# Without this key, NO model can serve generations.
MISTRAL_API_KEY=

# ── MUTED PROVIDERS (optional, currently unused) ───────────────────
# The four legacy providers below are MUTED in lib/ai-provider.ts:
# their models are hidden from the UI and they are removed from the
# fallback chain.  Keys are kept here for forward-compatibility —
# re-enabling a provider is a one-line change in ai-provider.ts
# (move its key into PROVIDER_FALLBACK_ORDER and set `active: true`).

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Supabase Postgres connection string. Get it from:
# Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Session pooler" / direct connection URL (NOT the transaction pooler
# with ?pgbouncer=true) for Prisma migrations. Example:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Resend API key for sending OTP emails. Get it from https://resend.com/api-keys
RESEND_API_KEY=
# Sender shown in OTP emails, e.g. "Codewix <noreply@codewix.in>"
RESEND_FROM_EMAIL=

# Optional, if you want observability via Braintrust
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=llamacoder

# Optional, if you want to upload code to S3
S3_UPLOAD_REGION=
S3_UPLOAD_BUCKET=
S3_UPLOAD_SECRET=
S3_UPLOAD_KEY=
